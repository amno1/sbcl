;;;; Tests for (DECLARE (SB-EXT:UNPIN-NIL)) on x86-64.

#-x86-64 (invoke-restart 'run-tests::skip-file)
#+interpreter (invoke-restart 'run-tests::skip-file)

(defun compile-capturing-unpin-notes (form)
  (let ((notes nil))
    (multiple-value-bind (fn warnings-p failure-p)
        (handler-bind ((sb-ext:compiler-note
                        (lambda (c)
                          (let ((msg (princ-to-string c)))
                            (when (search "Unable to unpin NIL" msg)
                              (push msg notes))))))
          (compile nil form))
      (values fn (nreverse notes) warnings-p failure-p))))

(defun disassembly-contains-p (fn needle)
  (let ((text (with-output-to-string (*standard-output*)
                (disassemble fn))))
    (not (null (search needle text)))))

(defun verify-nil-intact ()
  (assert (null nil))
  (assert (eq nil 'nil))
  (assert (equal (cons 1 nil) '(1))))

(with-test (:name :unpin-nil-allocates-r12-in-leaf-loop)
  (let* ((buf (make-array 256 :element-type '(unsigned-byte 64)))
         (_ (dotimes (i 256) (setf (aref buf i) (1+ (* i 17)))))
         (body
          '((declare (type (simple-array (unsigned-byte 64) (*)) buf)
                     (type fixnum n)
                     (optimize (speed 3) (safety 0) (debug 0)))
            (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
                  (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13) (s13 14))
              (declare (type (unsigned-byte 64)
                             s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13))
              (dotimes (i n)
                (let ((x (aref buf (logand i 255))))
                  (setf s0 (logand (+ s0 x) #xffffffffffffffff)
                        s1 (logand (logxor s1 (+ x 1)) #xffffffffffffffff)
                        s2 (logand (+ s2 (* x 3)) #xffffffffffffffff)
                        s3 (logand (- s3 x) #xffffffffffffffff)
                        s4 (logand (logxor s4 (* x 5)) #xffffffffffffffff)
                        s5 (logand (+ s5 x 7) #xffffffffffffffff)
                        s6 (logand (logxor s6 (+ x 9)) #xffffffffffffffff)
                        s7 (logand (+ s7 (* x 11)) #xffffffffffffffff)
                        s8 (logand (- s8 (* x 13)) #xffffffffffffffff)
                        s9 (logand (+ s9 (logxor x 15)) #xffffffffffffffff)
                        s10 (logand (+ s10 x 17) #xffffffffffffffff)
                        s11 (logand (logxor s11 (+ x 19)) #xffffffffffffffff)
                        s12 (logand (+ s12 (* x 21)) #xffffffffffffffff)
                        s13 (logand (+ s13 x 23) #xffffffffffffffff))))
              (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13)
                      most-positive-fixnum))))
         (pinned-fn (compile nil `(lambda (buf n) ,@body))))
    (declare (ignore _))
    (multiple-value-bind (unpinned-fn notes warnings-p failure-p)
        (compile-capturing-unpin-notes
         `(lambda (buf n)
            (declare (sb-ext:unpin-nil))
            ,@body))
      (assert (null notes))
      (assert (not warnings-p))
      (assert (not failure-p))
      (assert (disassembly-contains-p unpinned-fn "R12"))
      (assert (= (funcall unpinned-fn buf 2000)
                 (funcall pinned-fn buf 2000)))
      (verify-nil-intact))))

(with-test (:name :unpin-nil-with-many-spills)
  (let* ((vars '(a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11
                 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11))
         (bindings
          (loop for v in vars
                for i from 1
                collect `(,v (logand (+ (* x ,i) ,(* i 13)) #xffffffff))))
         (body
          `((declare (type (unsigned-byte 32) x)
                     (optimize (speed 3) (safety 0) (debug 0)))
            (let* ,bindings
              (declare (type (unsigned-byte 32) ,@vars))
              (dotimes (k 4)
                (setf a0 (logand (+ a0 b11 k) #xffffffff)
                      b0 (logand (logxor b0 a11) #xffffffff)
                      a5 (logand (+ a5 b5 x) #xffffffff)
                      b7 (logand (+ b7 a7 k) #xffffffff)))
              (logand (+ ,@(loop for v in vars collect `(truly-the (unsigned-byte 32) ,v)))
                      most-positive-fixnum))))
         (pinned (compile nil `(lambda (x) ,@body))))
    (multiple-value-bind (unpinned notes)
        (compile-capturing-unpin-notes
         `(lambda (x)
            (declare (sb-ext:unpin-nil))
            ,@body))
      (assert (null notes))
      (assert (disassembly-contains-p unpinned "R12"))
      (dolist (arg '(0 1 42 #xabcdef01))
        (assert (= (funcall unpinned arg) (funcall pinned arg))))
      (verify-nil-intact))))

(with-test (:name :unpin-nil-constant-pool-nil-and-empty-string)
  (multiple-value-bind (eq-nil-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (x)
         (declare (sb-ext:unpin-nil)
                  (optimize (speed 3) (safety 0)))
         (if (eq x nil) 11 22)))
    (assert (null notes))
    (assert (= (funcall eq-nil-fn nil) 11))
    (assert (= (funcall eq-nil-fn t) 22))
    (assert (= (funcall eq-nil-fn 0) 22)))
  (multiple-value-bind (empty-str-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (flag)
         (declare (sb-ext:unpin-nil)
                  (optimize (speed 3) (safety 0)))
         (if flag "" "nonempty")))
    (assert (null notes))
    (assert (string= (funcall empty-str-fn t) ""))
    (assert (string= (funcall empty-str-fn nil) "nonempty")))
  ;; LET/LET* in the same lambda environment stays unpinned.
  (multiple-value-bind (let-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (x)
         (declare (sb-ext:unpin-nil)
                  (type (signed-byte 60) x)
                  (optimize (speed 3) (safety 0)))
         (let* ((a (+ x 1))
                (b (+ a 2)))
           (+ a b))))
    (assert (null notes))
    (assert (= (funcall let-fn 10) 24)))
  (verify-nil-intact))

(with-test (:name :unpin-nil-fallbacks-and-compiler-notes)
  (labels ((expect-fallback (form expected-fragment args expected-result)
             (multiple-value-bind (fn notes)
                 (compile-capturing-unpin-notes
                  `(lambda ,(second form)
                     (declare (sb-ext:unpin-nil)
                              (optimize (speed 3) (safety 0)))
                     ,@(cddr form)))
               (assert (= (length notes) 1))
               (assert (search expected-fragment (first notes)))
               (assert (equal (apply fn args) expected-result))
               (verify-nil-intact))
             ;; At (speed 2), fallback happens silently without emitting notes.
             (multiple-value-bind (fn notes)
                 (compile-capturing-unpin-notes
                  `(lambda ,(second form)
                     (declare (sb-ext:unpin-nil)
                              (optimize (speed 2) (safety 0)))
                     ,@(cddr form)))
               (assert (null notes))
               (assert (equal (apply fn args) expected-result))
               (verify-nil-intact))))
    ;; :FULL call (non-tail single-value so it hits :FULL rather than :VALUES-RECEIVERS)
    (expect-fallback '(lambda (f x) (let ((y (funcall f x))) (the fixnum y)))
                     "(:FULL)"
                     (list #'1+ 41)
                     42)
    ;; :CLOSURE (non-tail local function needing closure/env link)
    (expect-fallback '(lambda (x)
                       (declare (type (signed-byte 32) x))
                       (labels ((h (z)
                                  (declare (type (signed-byte 32) z))
                                  (if (<= z 0) 0 (the fixnum (+ z (h (1- z)))))))
                         (+ (h x) 1)))
                     "(:CLOSURE)"
                     '(5)
                     16)
    ;; :NULL-TN (foreign callout via ALIEN-LINKAGE-TABLE)
    (expect-fallback '(lambda (x)
                       (sb-alien:alien-funcall
                        (sb-alien:extern-alien "getpid" (function sb-alien:int)))
                       x)
                     "(:NULL-TN)"
                     '(99)
                     99)
    ;; :CARD-TABLE-INDEX-MASK (vector write barrier)
    (let ((vec (vector :a :b)))
      (expect-fallback '(lambda (v x) (setf (svref v 0) x) (svref v 0))
                       "(:CARD-TABLE-INDEX-MASK)"
                       (list vec :ok)
                       :ok))
    ;; :CALL-VOP (generic arithmetic VOP with :save-p t calling assembly routine)
    (expect-fallback '(lambda (a b) (+ a b))
                     "(:CALL-VOP)"
                     '(100 23)
                     123)))

(with-test (:name :unpin-nil-compute-from-flags)
  (dolist (form '(((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0))) (null x))
                   ((nil) t) ((t) nil) ((0) nil))
                  ((lambda (a b)
                     (declare (sb-ext:unpin-nil) (type fixnum a b) (optimize (speed 3) (safety 0)))
                     (< a b))
                   ((1 2) t) ((2 1) nil) ((5 5) nil))
                  ((lambda (a b)
                     (declare (sb-ext:unpin-nil) (type fixnum a b) (optimize (speed 3) (safety 0)))
                     (not (< a b)))
                   ((1 2) nil) ((2 1) t) ((5 5) t))))
    (destructuring-bind (lambda-form &rest cases) form
      (multiple-value-bind (fn notes)
          (compile-capturing-unpin-notes lambda-form)
        (assert (null notes))
        (dolist (case cases)
          (destructuring-bind (args expected) case
            (assert (eq (apply fn args) expected)))))))
  (verify-nil-intact))

(with-test (:name :unpin-nil-type-vops)
  (dolist (form '(((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0))) (consp x))
                   (((1 . 2)) t) ((nil) nil) ((t) nil) ((42) nil))
                  ((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0))) (symbolp x))
                   ((nil) t) ((t) t) ((foo) t) ((42) nil) (((1)) nil))
                  ((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0))) (listp x))
                   ((nil) t) (((1)) t) ((t) nil) ((42) nil))
                  ((lambda (x)
                     (declare (sb-ext:unpin-nil)
                              (type (or simple-string null) x)
                              (optimize (speed 3) (safety 0)))
                     (simple-string-p x))
                   (("abc") t) ((nil) nil))
                  ((lambda (x)
                     (declare (sb-ext:unpin-nil)
                              (type (or simple-vector null) x)
                              (optimize (speed 3) (safety 0)))
                     (arrayp x))
                   ((#(1 2)) t) ((nil) nil))))
    (destructuring-bind (lambda-form &rest cases) form
      (multiple-value-bind (fn notes)
          (compile-capturing-unpin-notes lambda-form)
        (assert (null notes))
        (dolist (case cases)
          (destructuring-bind (args expected) case
            (assert (eq (apply fn args) expected)))))))
  (verify-nil-intact))

(with-test (:name :unpin-nil-list-and-symbol-vops)
  ;; LENGTH on LIST (fast-length/list and length/list)
  (dolist (safety '(0 1))
    (multiple-value-bind (len-fn notes)
        (compile-capturing-unpin-notes
         `(lambda (xs)
            (declare (sb-ext:unpin-nil)
                     (type list xs)
                     (optimize (speed 3) (safety ,safety)))
            (length xs)))
      (assert (null notes))
      (assert (= (funcall len-fn nil) 0))
      (assert (= (funcall len-fn '(a b c d)) 4))))
  ;; FDEFN-FUN on a fresh FDEFN (returns NIL when unbound)
  (multiple-value-bind (fd-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (fd)
          (declare (sb-ext:unpin-nil)
                   (type sb-kernel:fdefn fd)
                   (optimize (speed 3) (safety 0)))
          (sb-kernel:fdefn-fun fd)))
    (assert (null notes))
    (assert (null (funcall fd-fn (sb-kernel:make-fdefn 'unpin-nil-unbound-sym)))))
  ;; SYMBOL-HASH matches pinned hash
  (let ((pinned-hash (compile nil '(lambda (s)
                                     (declare (type symbol s)
                                              (optimize (speed 3) (safety 0)))
                                     (sb-kernel:symbol-hash s)))))
    (multiple-value-bind (unpinned-hash notes)
        (compile-capturing-unpin-notes
         '(lambda (s)
            (declare (sb-ext:unpin-nil)
                     (type symbol s)
                     (optimize (speed 3) (safety 0)))
            (sb-kernel:symbol-hash s)))
      (assert (null notes))
      (dolist (sym '(nil t foo car +))
        (assert (= (funcall unpinned-hash sym) (funcall pinned-hash sym))))))
  (verify-nil-intact))

(with-test (:name :unpin-nil-unwind-restores-r12)
  (multiple-value-bind (div-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (a b)
         (declare (sb-ext:unpin-nil)
                  (type (signed-byte 32) a b)
                  (optimize (speed 3) (safety 1)))
         (let ((x0 (+ a 1)) (x1 (+ a 2)) (x2 (+ a 3)) (x3 (+ a 4))
               (x4 (+ a 5)) (x5 (+ a 6)) (x6 (+ a 7)) (x7 (+ a 8))
               (x8 (+ a 9)) (x9 (+ a 10)) (x10 (+ a 11)) (x11 (+ a 12))
               (x12 (+ a 13)))
           (declare (type (signed-byte 36) x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12))
           (+ (truncate (+ x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12) b)
              x12))))
    (assert (null notes))
    (assert (disassembly-contains-p div-fn "R12"))
    (let ((unwound
           (handler-case (funcall div-fn 5 0)
             (division-by-zero () :unwound))))
      (assert (eq unwound :unwound)))
    (verify-nil-intact)))

#+sb-thread
(with-test (:name :unpin-nil-interrupt-thread-and-gc)
  (let* ((buf (make-array 64 :element-type '(unsigned-byte 64)))
         (_ (dotimes (i 64) (setf (aref buf i) (1+ (* i 13)))))
         (loop-fn
          (compile-capturing-unpin-notes
           '(lambda (buf n)
             (declare (sb-ext:unpin-nil)
                      (type (simple-array (unsigned-byte 64) (*)) buf)
                      (type fixnum n)
                      (optimize (speed 3) (safety 0) (debug 0)))
             (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
                   (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13))
               (declare (type (unsigned-byte 64)
                              s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12))
               (dotimes (i n)
                 (let ((x (aref buf (logand i 63))))
                   (setf s0 (logand (+ s0 x) #xffffffffffffffff)
                         s1 (logand (logxor s1 x) #xffffffffffffffff)
                         s2 (logand (+ s2 (* x 3)) #xffffffffffffffff)
                         s3 (logand (- s3 x) #xffffffffffffffff)
                         s4 (logand (logxor s4 (* x 5)) #xffffffffffffffff)
                         s5 (logand (+ s5 x 7) #xffffffffffffffff)
                         s6 (logand (+ s6 x 9) #xffffffffffffffff)
                         s7 (logand (+ s7 (* x 11)) #xffffffffffffffff)
                         s8 (logand (- s8 (* x 13)) #xffffffffffffffff)
                         s9 (logand (+ s9 x 15) #xffffffffffffffff)
                         s10 (logand (+ s10 x 17) #xffffffffffffffff)
                         s11 (logand (logxor s11 (+ x 19)) #xffffffffffffffff)
                         s12 (logand (+ s12 (* x 21)) #xffffffffffffffff))))
               (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12)
                       most-positive-fixnum))))))
    (declare (ignore _))
    (assert (disassembly-contains-p loop-fn "R12"))
    (let* ((expected (funcall loop-fn buf 200000))
           (done nil)
           (interrupts 0)
           (worker
            (sb-thread:make-thread
             (lambda ()
               (dotimes (iter 40)
                 (let ((got (funcall loop-fn buf 200000)))
                   (assert (= got expected))
                   (verify-nil-intact)))
               (setf done t))
             :name "unpin-nil-worker")))
      (loop until done
            for k from 0
            do (sleep 0.002)
               (ignore-errors
                 (sb-thread:interrupt-thread
                  worker
                  (lambda ()
                    (verify-nil-intact)
                    (incf interrupts)
                    (when (zerop (mod k 5))
                      (sb-ext:gc :full t))))))
      (sb-thread:join-thread worker)
      (assert (> interrupts 0))
      (verify-nil-intact))))

;;; The declaration is looked at only in a function's own declarations;
;;; inside LOCALLY it is accepted, ignored, and the code stays correct.
(with-test (:name :unpin-nil-only-function-level)
  (let ((inner (compile nil '(lambda (x)
                              (locally (declare (sb-ext:unpin-nil))
                                (if x (list x nil t) nil)))))
        (outer (compile nil '(lambda (x)
                              (declare (sb-ext:unpin-nil))
                              (if x (list x nil t) nil)))))
    (assert (equal (funcall inner 1) '(1 nil t)))
    (assert (equal (funcall outer 1) '(1 nil t)))
    (assert (null (funcall inner nil)))
    (assert (null (funcall outer nil)))
    ;; Nothing in the LOCALLY version reserves R12, so it doesn't note a
    ;; fallback either.
    (assert (null (nth-value 1 (compile-capturing-unpin-notes
                                '(lambda (x)
                                  (locally (declare (sb-ext:unpin-nil))
                                    (if x (list x nil t) nil)))))))))

;;; NIL and static symbols are in the constant pool only while NIL is
;;; unpinned; other components still see them as immediates.
(with-test (:name :unpin-nil-immediate-constant-sc)
  (assert (eql (sb-vm::immediate-constant-sc nil) sb-vm:immediate-sc-number))
  (assert (eql (sb-vm::immediate-constant-sc t) sb-vm:immediate-sc-number))
  (assert (eql (sb-vm::immediate-constant-sc 42) sb-vm:immediate-sc-number)))
