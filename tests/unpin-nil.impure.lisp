;;;; Tests for (DECLARE (SB-EXT:UNPIN-NIL)) on x86-64.

#-x86-64 (invoke-restart 'run-tests::skip-file)
#+interpreter (invoke-restart 'run-tests::skip-file)

(defun compile-capturing-unpin-notes (form)
  (let ((notes nil))
    (multiple-value-bind (fn warnings-p failure-p)
        (handler-bind ((sb-ext:compiler-note
                        (lambda (c)
                          (let ((msg (princ-to-string c)))
                            (when (search "Unable to unpin NIL" msg)
                              (push msg notes))))))
          (compile nil form))
      (values fn (nreverse notes) warnings-p failure-p))))

(defun disassembly-contains-p (fn needle)
  (let ((text (with-output-to-string (*standard-output*)
                (disassemble fn))))
    (not (null (search needle text)))))

(defun verify-nil-intact ()
  (assert (null nil))
  (assert (eq nil 'nil))
  (assert (equal (cons 1 nil) '(1))))

(with-test (:name :unpin-nil-allocates-r12-in-leaf-loop)
  (let* ((buf (make-array 256 :element-type '(unsigned-byte 64)))
         (_ (dotimes (i 256) (setf (aref buf i) (1+ (* i 17)))))
         (body
          '((declare (type (simple-array (unsigned-byte 64) (*)) buf)
                     (type fixnum n)
                     (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
            (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
                  (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13) (s13 14))
              (declare (type (unsigned-byte 64)
                             s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13))
              (dotimes (i n)
                (let ((x (aref buf (logand i 255))))
                  (setf s0 (logand (+ s0 x) #xffffffffffffffff)
                        s1 (logand (logxor s1 (+ x 1)) #xffffffffffffffff)
                        s2 (logand (+ s2 (* x 3)) #xffffffffffffffff)
                        s3 (logand (- s3 x) #xffffffffffffffff)
                        s4 (logand (logxor s4 (* x 5)) #xffffffffffffffff)
                        s5 (logand (+ s5 x 7) #xffffffffffffffff)
                        s6 (logand (logxor s6 (+ x 9)) #xffffffffffffffff)
                        s7 (logand (+ s7 (* x 11)) #xffffffffffffffff)
                        s8 (logand (- s8 (* x 13)) #xffffffffffffffff)
                        s9 (logand (+ s9 (logxor x 15)) #xffffffffffffffff)
                        s10 (logand (+ s10 x 17) #xffffffffffffffff)
                        s11 (logand (logxor s11 (+ x 19)) #xffffffffffffffff)
                        s12 (logand (+ s12 (* x 21)) #xffffffffffffffff)
                        s13 (logand (+ s13 x 23) #xffffffffffffffff))))
              (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13)
                      most-positive-fixnum))))
         (pinned-fn (compile nil `(lambda (buf n) ,@body))))
    (declare (ignore _))
    (multiple-value-bind (unpinned-fn notes warnings-p failure-p)
        (compile-capturing-unpin-notes
         `(lambda (buf n)
            (declare (sb-ext:unpin-nil))
            ,@body))
      (assert (null notes))
      (assert (not warnings-p))
      (assert (not failure-p))
      (assert (disassembly-contains-p unpinned-fn "R12"))
      (assert (= (funcall unpinned-fn buf 2000)
                 (funcall pinned-fn buf 2000)))
      (verify-nil-intact))))

(with-test (:name :unpin-nil-with-many-spills)
  (let* ((vars '(a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11
                 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11))
         (bindings
          (loop for v in vars
                for i from 1
                collect `(,v (logand (+ (* x ,i) ,(* i 13)) #xffffffff))))
         (body
          `((declare (type (unsigned-byte 32) x)
                     (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
            (let* ,bindings
              (declare (type (unsigned-byte 32) ,@vars))
              (dotimes (k 4)
                (setf a0 (logand (+ a0 b11 k) #xffffffff)
                      b0 (logand (logxor b0 a11) #xffffffff)
                      a5 (logand (+ a5 b5 x) #xffffffff)
                      b7 (logand (+ b7 a7 k) #xffffffff)))
              (logand (+ ,@(loop for v in vars collect `(truly-the (unsigned-byte 32) ,v)))
                      most-positive-fixnum))))
         (pinned (compile nil `(lambda (x) ,@body))))
    (multiple-value-bind (unpinned notes)
        (compile-capturing-unpin-notes
         `(lambda (x)
            (declare (sb-ext:unpin-nil))
            ,@body))
      (assert (null notes))
      (assert (disassembly-contains-p unpinned "R12"))
      (dolist (arg '(0 1 42 #xabcdef01))
        (assert (= (funcall unpinned arg) (funcall pinned arg))))
      (verify-nil-intact))))

(with-test (:name :unpin-nil-constant-pool-nil-and-empty-string)
  (multiple-value-bind (eq-nil-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (x)
         (declare (sb-ext:unpin-nil)
                  (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
         (if (eq x nil) 11 22)))
    (assert (null notes))
    (assert (= (funcall eq-nil-fn nil) 11))
    (assert (= (funcall eq-nil-fn t) 22))
    (assert (= (funcall eq-nil-fn 0) 22)))
  (multiple-value-bind (empty-str-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (flag)
         (declare (sb-ext:unpin-nil)
                  (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
         (if flag "" "nonempty")))
    (assert (null notes))
    (assert (string= (funcall empty-str-fn t) ""))
    (assert (string= (funcall empty-str-fn nil) "nonempty")))
  ;; LET/LET* in the same lambda environment stays unpinned.
  (multiple-value-bind (let-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (x)
         (declare (sb-ext:unpin-nil)
                  (type (signed-byte 60) x)
                  (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
         (let* ((a (+ x 1))
                (b (+ a 2)))
           (+ a b))))
    (assert (null notes))
    (assert (= (funcall let-fn 10) 24)))
  (verify-nil-intact))

(with-test (:name :unpin-nil-fallbacks-and-compiler-notes)
  (labels ((expect-fallback (form expected-fragment args expected-result)
             (multiple-value-bind (fn notes)
                 (compile-capturing-unpin-notes
                  `(lambda ,(second form)
                     (declare (sb-ext:unpin-nil)
                              (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     ,@(cddr form)))
               (assert (= (length notes) 1))
               (assert (search expected-fragment (first notes)))
               (assert (equal (apply fn args) expected-result))
               (verify-nil-intact))
             ;; At (speed 2), fallback happens silently without emitting notes.
             (multiple-value-bind (fn notes)
                 (compile-capturing-unpin-notes
                  `(lambda ,(second form)
                     (declare (sb-ext:unpin-nil)
                              (optimize (speed 2) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     ,@(cddr form)))
               (assert (null notes))
               (assert (equal (apply fn args) expected-result))
               (verify-nil-intact))))
    ;; :VALUES-RECEIVERS (a full tail call returns unknown values; non-tail full
    ;; calls are fine)
    (expect-fallback '(lambda (f x) (funcall f x))
                     "(:VALUES-RECEIVERS)"
                     (list #'1+ 41)
                     42)
    ;; :LOCAL-CALL (a non-tail call of a recursive local function; it used to
    ;; be reported as :CLOSURE, but it makes no closure)
    (expect-fallback '(lambda (x)
                       (declare (type (signed-byte 32) x))
                       (labels ((h (z)
                                  (declare (type (signed-byte 32) z))
                                  (if (<= z 0) 0 (the fixnum (+ z (h (1- z)))))))
                         (+ (h x) 1)))
                     "(:LOCAL-CALL)"
                     '(5)
                     16)
    ;; :NULL-TN (foreign callout via ALIEN-LINKAGE-TABLE)
    (expect-fallback '(lambda (x)
                       (sb-alien:alien-funcall
                        (sb-alien:extern-alien "getpid" (function sb-alien:int)))
                       x)
                     "(:NULL-TN)"
                     '(99)
                     99)
    ;; :CARD-TABLE-INDEX-MASK (vector write barrier)
    (let ((vec (vector :a :b)))
      (expect-fallback '(lambda (v x) (setf (svref v 0) x) (svref v 0))
                       "(:CARD-TABLE-INDEX-MASK)"
                       (list vec :ok)
                       :ok))
    ;; :CALL-VOP (generic arithmetic VOP with :save-p t calling assembly routine)
    (expect-fallback '(lambda (a b) (+ a b))
                     "(:CALL-VOP)"
                     '(100 23)
                     123)))

(with-test (:name :unpin-nil-compute-from-flags)
  (dolist (form '(((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0))) (null x))
                   ((nil) t) ((t) nil) ((0) nil))
                  ((lambda (a b)
                     (declare (sb-ext:unpin-nil) (type fixnum a b) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (< a b))
                   ((1 2) t) ((2 1) nil) ((5 5) nil))
                  ((lambda (a b)
                     (declare (sb-ext:unpin-nil) (type fixnum a b) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (not (< a b)))
                   ((1 2) nil) ((2 1) t) ((5 5) t))))
    (destructuring-bind (lambda-form &rest cases) form
      (multiple-value-bind (fn notes)
          (compile-capturing-unpin-notes lambda-form)
        (assert (null notes))
        (dolist (case cases)
          (destructuring-bind (args expected) case
            (assert (eq (apply fn args) expected)))))))
  (verify-nil-intact))

(with-test (:name :unpin-nil-type-vops)
  (dolist (form '(((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0))) (consp x))
                   (((1 . 2)) t) ((nil) nil) ((t) nil) ((42) nil))
                  ((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0))) (symbolp x))
                   ((nil) t) ((t) t) ((foo) t) ((42) nil) (((1)) nil))
                  ((lambda (x) (declare (sb-ext:unpin-nil) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0))) (listp x))
                   ((nil) t) (((1)) t) ((t) nil) ((42) nil))
                  ((lambda (x)
                     (declare (sb-ext:unpin-nil)
                              (type (or simple-string null) x)
                              (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (simple-string-p x))
                   (("abc") t) ((nil) nil))
                  ((lambda (x)
                     (declare (sb-ext:unpin-nil)
                              (type (or simple-vector null) x)
                              (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (arrayp x))
                   ((#(1 2)) t) ((nil) nil))))
    (destructuring-bind (lambda-form &rest cases) form
      (multiple-value-bind (fn notes)
          (compile-capturing-unpin-notes lambda-form)
        (assert (null notes))
        (dolist (case cases)
          (destructuring-bind (args expected) case
            (assert (eq (apply fn args) expected)))))))
  (verify-nil-intact))

(with-test (:name :unpin-nil-list-and-symbol-vops)
  ;; LENGTH on LIST (fast-length/list and length/list)
  (dolist (safety '(0 1))
    (multiple-value-bind (len-fn notes)
        (compile-capturing-unpin-notes
         `(lambda (xs)
            (declare (sb-ext:unpin-nil)
                     (type list xs)
                     (optimize (speed 3) (safety ,safety) #+sb-safepoint (sb-c:insert-safepoints 0)))
            (length xs)))
      (assert (null notes))
      (assert (= (funcall len-fn nil) 0))
      (assert (= (funcall len-fn '(a b c d)) 4))))
  ;; FDEFN-FUN on a fresh FDEFN (returns NIL when unbound)
  (multiple-value-bind (fd-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (fd)
          (declare (sb-ext:unpin-nil)
                   (type sb-kernel:fdefn fd)
                   (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
          (sb-kernel:fdefn-fun fd)))
    (assert (null notes))
    (assert (null (funcall fd-fn (sb-kernel:make-fdefn 'unpin-nil-unbound-sym)))))
  ;; SYMBOL-HASH matches pinned hash
  (let ((pinned-hash (compile nil '(lambda (s)
                                     (declare (type symbol s)
                                              (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                                     (sb-kernel:symbol-hash s)))))
    (multiple-value-bind (unpinned-hash notes)
        (compile-capturing-unpin-notes
         '(lambda (s)
            (declare (sb-ext:unpin-nil)
                     (type symbol s)
                     (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
            (sb-kernel:symbol-hash s)))
      (assert (null notes))
      (dolist (sym '(nil t foo car +))
        (assert (= (funcall unpinned-hash sym) (funcall pinned-hash sym))))))
  (verify-nil-intact))

(with-test (:name :unpin-nil-unwind-restores-r12)
  (multiple-value-bind (div-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (a b)
         (declare (sb-ext:unpin-nil)
                  (type (signed-byte 32) a b)
                  (optimize (speed 3) (safety 1) #+sb-safepoint (sb-c:insert-safepoints 0)))
         (let ((x0 (+ a 1)) (x1 (+ a 2)) (x2 (+ a 3)) (x3 (+ a 4))
               (x4 (+ a 5)) (x5 (+ a 6)) (x6 (+ a 7)) (x7 (+ a 8))
               (x8 (+ a 9)) (x9 (+ a 10)) (x10 (+ a 11)) (x11 (+ a 12))
               (x12 (+ a 13)))
           (declare (type (signed-byte 36) x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12))
           (+ (truncate (+ x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12) b)
              x12))))
    (assert (null notes))
    (assert (disassembly-contains-p div-fn "R12"))
    (let ((unwound
           (handler-case (funcall div-fn 5 0)
             (division-by-zero () :unwound))))
      (assert (eq unwound :unwound)))
    (verify-nil-intact)))

#+sb-thread
(with-test (:name :unpin-nil-interrupt-thread-and-gc)
  (let* ((buf (make-array 64 :element-type '(unsigned-byte 64)))
         (_ (dotimes (i 64) (setf (aref buf i) (1+ (* i 13)))))
         (loop-fn
          (compile-capturing-unpin-notes
           '(lambda (buf n)
             (declare (sb-ext:unpin-nil)
                      (type (simple-array (unsigned-byte 64) (*)) buf)
                      (type fixnum n)
                      (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
             (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
                   (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13))
               (declare (type (unsigned-byte 64)
                              s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12))
               (dotimes (i n)
                 (let ((x (aref buf (logand i 63))))
                   (setf s0 (logand (+ s0 x) #xffffffffffffffff)
                         s1 (logand (logxor s1 x) #xffffffffffffffff)
                         s2 (logand (+ s2 (* x 3)) #xffffffffffffffff)
                         s3 (logand (- s3 x) #xffffffffffffffff)
                         s4 (logand (logxor s4 (* x 5)) #xffffffffffffffff)
                         s5 (logand (+ s5 x 7) #xffffffffffffffff)
                         s6 (logand (+ s6 x 9) #xffffffffffffffff)
                         s7 (logand (+ s7 (* x 11)) #xffffffffffffffff)
                         s8 (logand (- s8 (* x 13)) #xffffffffffffffff)
                         s9 (logand (+ s9 x 15) #xffffffffffffffff)
                         s10 (logand (+ s10 x 17) #xffffffffffffffff)
                         s11 (logand (logxor s11 (+ x 19)) #xffffffffffffffff)
                         s12 (logand (+ s12 (* x 21)) #xffffffffffffffff))))
               (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12)
                       most-positive-fixnum))))))
    (declare (ignore _))
    (assert (disassembly-contains-p loop-fn "R12"))
    (let* ((expected (funcall loop-fn buf 200000))
           (done nil)
           (interrupts 0)
           (worker
            (sb-thread:make-thread
             (lambda ()
               (dotimes (iter 40)
                 (let ((got (funcall loop-fn buf 200000)))
                   (assert (= got expected))
                   (verify-nil-intact)))
               (setf done t))
             :name "unpin-nil-worker")))
      (loop until done
            for k from 0
            do (sleep 0.002)
               (ignore-errors
                 (sb-thread:interrupt-thread
                  worker
                  (lambda ()
                    (verify-nil-intact)
                    (incf interrupts)
                    (when (zerop (mod k 5))
                      (sb-ext:gc :full t))))))
      (sb-thread:join-thread worker)
      (assert (> interrupts 0))
      (verify-nil-intact))))

;;; The declaration is looked at only in a function's own declarations;
;;; inside LOCALLY it is accepted, ignored, and the code stays correct.
(with-test (:name :unpin-nil-only-function-level)
  (let ((inner (compile nil '(lambda (x)
                              (locally (declare (sb-ext:unpin-nil))
                                (if x (list x nil t) nil)))))
        (outer (compile nil '(lambda (x)
                              (declare (sb-ext:unpin-nil))
                              (if x (list x nil t) nil)))))
    (assert (equal (funcall inner 1) '(1 nil t)))
    (assert (equal (funcall outer 1) '(1 nil t)))
    (assert (null (funcall inner nil)))
    (assert (null (funcall outer nil)))
    ;; Nothing in the LOCALLY version reserves R12, so it doesn't note a
    ;; fallback either.
    (assert (null (nth-value 1 (compile-capturing-unpin-notes
                                '(lambda (x)
                                  (locally (declare (sb-ext:unpin-nil))
                                    (if x (list x nil t) nil)))))))))

;;; NIL and static symbols are in the constant pool only while NIL is
;;; unpinned; other components still see them as immediates.
(with-test (:name :unpin-nil-immediate-constant-sc)
  (assert (eql (sb-vm::immediate-constant-sc nil) sb-vm:immediate-sc-number))
  (assert (eql (sb-vm::immediate-constant-sc t) sb-vm:immediate-sc-number))
  (assert (eql (sb-vm::immediate-constant-sc 42) sb-vm:immediate-sc-number)))

;;; Verify converted VOPs actually stay unpinned (NULL notes) under register
;;; pressure that allocates R12, and handle stack spills cleanly.
(with-test (:name :unpin-nil-converted-vops-allocate-r12)
  (let* ((vars '(s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19))
         (inits (loop for v in vars
                      for i from 1
                      collect `(,v (logand (+ k ,i) #xffffff))))
         (step (loop for v in vars
                     for i from 1
                     collect `(setf ,v (logand (+ ,v (* k ,i)) #xffffff))))
         (sum `(logand (+ ,@vars) most-positive-fixnum)))
    (flet ((check-pressured (form expected-fn)
             (multiple-value-bind (fn notes) (compile-capturing-unpin-notes form)
               (assert (null notes))
               (assert (disassembly-contains-p fn "R12"))
               (funcall expected-fn fn))))
      ;; compute-from-flags under R12 register pressure
      (check-pressured
       `(lambda (k x y)
          (declare (sb-ext:unpin-nil)
                   (type (unsigned-byte 24) k y)
                   (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
          (let* ,inits
            (declare (type (unsigned-byte 24) ,@vars))
            ,@step
            (let ((b0 (null x))
                  (b1 (< k y)))
              (values b0 b1 ,sum))))
       (lambda (fn)
         (assert (equal (multiple-value-list (funcall fn 3 nil 5))
                        (list t t (nth-value 2 (funcall fn 3 nil 5)))))
         (assert (equal (multiple-value-list (funcall fn 5 'a 3))
                        (list nil nil (nth-value 2 (funcall fn 5 'a 3)))))))
      ;; type-vops under high register pressure (many variables spilled to stack)
      (check-pressured
       `(lambda (k x0 x1 x2)
          (declare (sb-ext:unpin-nil)
                   (type (unsigned-byte 24) k)
                   (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
          (let* ,inits
            (declare (type (unsigned-byte 24) ,@vars))
            ,@step
            (let ((r-sym (symbolp x0))
                  (r-cons (consp x1))
                  (r-str (let ((v (the (or simple-string null) x2)))
                           (simple-string-p v))))
              (values r-sym r-cons r-str ,sum))))
       (lambda (fn)
         (assert (eq (nth-value 0 (funcall fn 7 'sym nil nil)) t))
         (assert (eq (nth-value 0 (funcall fn 7 nil nil nil)) t))
         (assert (eq (nth-value 0 (funcall fn 7 42 nil nil)) nil))
         (assert (eq (nth-value 1 (funcall fn 7 nil '(1 . 2) nil)) t))
         (assert (eq (nth-value 1 (funcall fn 7 nil nil nil)) nil))
         (assert (eq (nth-value 2 (funcall fn 7 nil nil "ok")) t))
         (assert (eq (nth-value 2 (funcall fn 7 nil nil nil)) nil))))
      ;; list length + symbol-hash + fdefn-fun under R12 register pressure
      (let ((fd (sb-kernel:make-fdefn 'unpin-nil-pressured-unbound-sym))
            (pinned-hash (sb-kernel:symbol-hash 'unpin-nil-pressured-sym)))
        (check-pressured
         `(lambda (k xs sym fd)
            (declare (sb-ext:unpin-nil)
                     (type (unsigned-byte 24) k)
                     (type list xs)
                     (type symbol sym)
                     (type sb-kernel:fdefn fd)
                     (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
            (let* ,inits
              (declare (type (unsigned-byte 24) ,@vars))
              ,@step
              (values (length xs)
                      (sb-kernel:symbol-hash sym)
                      (sb-kernel:fdefn-fun fd)
                      ,sum)))
         (lambda (fn)
           (multiple-value-bind (len hash fdfun)
               (funcall fn 9 '(a b c) 'unpin-nil-pressured-sym fd)
             (assert (= len 3))
             (assert (= hash pinned-hash))
             (assert (null fdfun)))
           (assert (= (funcall fn 9 nil 'nil fd) 0))))))))

;;; Adding NIL to the constant pool during codegen via BOXED-CONSTANT-TN must not
;;; perturb RIP-relative offsets of earlier constants in the same component.
(with-test (:name :unpin-nil-late-constant-pool-append)
  (let* ((c1 (list 'early-1 101))
         (c2 (vector 10 20 30))
         (c3 "early-string-3")
         (c4 'early-symbol-4)
         (c5 (list 'early-5 505))
         (vars '(r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13))
         (inits (loop for v in vars
                      for i from 1
                      collect `(,v (logand (+ k ,i) #xffffff))))
         (step (loop for v in vars
                     for i from 1
                     collect `(setf ,v (logand (logxor ,v (+ k ,i)) #xffffff)))))
    (multiple-value-bind (fn notes)
        (compile-capturing-unpin-notes
         `(lambda (k sym)
            (declare (sb-ext:unpin-nil)
                     (type (unsigned-byte 24) k)
                     (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
            (let* (,@inits
                   (e1 ',c1)
                   (e2 ',c2)
                   (e3 ,c3)
                   (e4 ',c4)
                   (e5 ',c5))
              (declare (type (unsigned-byte 24) ,@vars))
              ,@step
              ;; SYMBOLP appends NIL via BOXED-CONSTANT-TN during codegen,
              ;; after the earlier constants above have already been packed.
              (let ((is-sym (symbolp sym)))
                (values e1 e2 e3 e4 e5 is-sym
                        (logand (+ ,@vars) most-positive-fixnum))))))
      (assert (null notes))
      (assert (disassembly-contains-p fn "R12"))
      (multiple-value-bind (o1 o2 o3 o4 o5 is-sym)
          (funcall fn 17 'foo)
        (assert (eq o1 c1))
        (assert (eq o2 c2))
        (assert (string= o3 c3))
        (assert (eq o4 c4))
        (assert (eq o5 c5))
        (assert (eq is-sym t)))
      (assert (eq (nth-value 5 (funcall fn 17 123)) nil)))))

;;; Regression tests for fallback/retry idempotence in RESET-COMPONENT-FOR-PINNED-RETRY.
(with-test (:name :unpin-nil-retry-safety)
  ;; MAKE-ARRAY-HEADER* must not destructively pop combination args before retry.
  (multiple-value-bind (arr-fn notes)
      (compile-capturing-unpin-notes
       '(lambda ()
          (declare (sb-ext:unpin-nil)
                   (optimize (speed 0) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
          (let ((a (the (satisfies eval) (make-array 4 :fill-pointer 0))))
            (and (array-in-bounds-p a 0)
                 (array-in-bounds-p a 1)))))
    (declare (ignore notes))
    (assert (eq (funcall arr-fn) t)))
  ;; Fallback after IR2-CONVERT must not emit duplicate compiler warnings.
  (let ((warnings nil))
    (multiple-value-bind (fn failurep)
        (handler-bind ((warning (lambda (c) (push c warnings))))
          (compile nil '(lambda (v)
                          (declare (sb-ext:unpin-nil))
                          (values (svref v 0) (vector-pop v)))))
      (declare (ignore fn failurep))
      (assert (= (length warnings) 1))))
  ;; Fallback after IR2-CONVERT must not drop LVAR-annotation warnings or
  ;; duplicate warnings.
  (let ((warnings nil))
    (multiple-value-bind (fn failurep)
        (handler-bind ((warning (lambda (c) (push c warnings))))
          (compile nil '(lambda (x)
                          (declare (sb-ext:unpin-nil))
                          (setf (svref #(a b c) 1) x))))
      (declare (ignore fn failurep))
      (assert (= (length warnings) 1))
      (assert (typep (first warnings) 'sb-int:constant-modified))))
  ;; CALC-PHASH followed by a codegen trap (vector write barrier) must not crash on retry.
  (let* ((box (vector nil))
         (ph-fn (compile nil '(lambda (val box x)
                                (declare (sb-ext:unpin-nil)
                                         (type (unsigned-byte 32) val)
                                         (type simple-vector box)
                                         (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                                (let ((h (sb-vm::calc-phash
                                          val 2 #((sb-c::shr sb-c::t0 1)
                                                  (sb-c::xor sb-c::t0 #xffff)))))
                                  (setf (svref box 0) x)
                                  (values h (svref box 0)))))))
    (assert (equal (multiple-value-list (funcall ph-fn 12 box :ok))
                   '(65523 :ok)))))

;;; The values COMPILE returns, and the diagnostics, are those of a compile
;;; without the declaration, whether or not the component falls back.
(with-test (:name :unpin-nil-diagnostics-match-pinned)
  (flet ((run (declare-p form-body)
           (let ((messages nil))
             (multiple-value-bind (fn warnings-p failure-p)
                 (handler-bind ((warning (lambda (c)
                                           (push (princ-to-string c) messages)
                                           (muffle-warning c))))
                   (compile nil `(lambda (x)
                                   ,@(when declare-p '((declare (sb-ext:unpin-nil))))
                                   ,form-body)))
               (declare (ignore fn))
               (list warnings-p failure-p (sort messages #'string<))))))
    ;; A compile-time type error, in a component that falls back (it conses).
    (let ((body '(list x (+ 1 "a"))))
      (assert (equal (run nil body) (run t body))))
    ;; A full warning in one that doesn't.
    (let ((body '(+ (the fixnum x) "a")))
      (assert (equal (run nil body) (run t body))))))

;;; An operand that lives on the stack can't be compared to the NIL in the
;;; constant pool; the component then keeps R12 pinned and stays correct.
(with-test (:name :unpin-nil-stack-operand-falls-back)
  (let* ((vars '(a b c d e f g h i j k l m n o p q r s u v w))
         (fn (compile nil
                      `(lambda (x ,@vars)
                         (declare (sb-ext:unpin-nil) (fixnum ,@vars)
                                  (optimize (speed 1) (safety 1) #+sb-safepoint (sb-c:insert-safepoints 0)))
                         (let ((r1 (typep x '(or null simple-string)))
                               (r2 (symbolp x))
                               (r3 (consp x)))
                           (list r1 r2 r3 (+ ,@vars)))))))
    (assert (equal (apply fn nil (loop for i below 22 collect i))
                   (list t t nil (reduce #'+ (loop for i below 22 collect i)))))
    (assert (equal (apply fn "s" (loop for i below 22 collect i))
                   (list t nil nil (reduce #'+ (loop for i below 22 collect i)))))
    (assert (equal (apply fn '(1) (loop for i below 22 collect i))
                   (list nil nil t (reduce #'+ (loop for i below 22 collect i)))))))

;;; A fallback leaves the flow graph as it found it: the retry still merges the
;;; two float-to-pointer coercions, as an undeclared compile does.
(with-test (:name :unpin-nil-retry-keeps-reused-coercion)
  (flet ((coercion-notes (declare-p)
           (let ((notes nil))
             (handler-bind ((sb-ext:compiler-note
                              (lambda (c)
                                (let ((m (princ-to-string c)))
                                  (when (search "float to pointer" m) (push m notes)))
                                (muffle-warning c))))
               (compile nil `(lambda (x d)
                               (declare (double-float d) (fixnum x)
                                        (optimize speed #+sb-safepoint (sb-c:insert-safepoints 0))
                                        ,@(when declare-p '((sb-ext:unpin-nil))))
                               (cond ((= x 1) (+ d 1))
                                     ((= x 2) (+ d 2))
                                     ((= x 3) (+ d 3))))))
             (length notes))))
    (assert (= (coercion-notes nil) 1))
    (assert (= (coercion-notes t) 1))))

;;; Converted nil-operand sites: move-if, if-eq, emit-sap-set, and multi-value
;;; CRETURN (< register-arg-count) compile unpinned with R12 available as a GPR.
(with-test (:name :unpin-nil-converted-vops-batch-1)
  ;; MOVE-IF with NIL branches and IF-EQ with constant NIL under register pressure.
  (multiple-value-bind (fn notes)
      (compile-capturing-unpin-notes
       '(lambda (buf n x y)
         (declare (type (simple-array (unsigned-byte 64) (*)) buf)
                  (type fixnum n)
                  (type (or null fixnum) y)
                  (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0))
                  (sb-ext:unpin-nil))
         (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
               (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13)
               (r1 (if (eq x nil) 10 20))
               (r2 (if (eq y nil) 30 40))
               (m1 (if (zerop n) nil y))
               (m2 (if (zerop n) x nil)))
           (declare (type (unsigned-byte 64)
                          s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12)
                    (type fixnum r1 r2))
           (dotimes (i n)
             (let ((v (aref buf (logand i 63))))
               (setf s0 (logand (+ s0 v) #xffffffffffffffff)
                     s1 (logand (logxor s1 (+ v 1)) #xffffffffffffffff)
                     s2 (logand (+ s2 (* v 3)) #xffffffffffffffff)
                     s3 (logand (- s3 v) #xffffffffffffffff)
                     s4 (logand (logxor s4 (* v 5)) #xffffffffffffffff)
                     s5 (logand (+ s5 v 7) #xffffffffffffffff)
                     s6 (logand (logxor s6 (+ v 9)) #xffffffffffffffff)
                     s7 (logand (+ s7 (* v 11)) #xffffffffffffffff)
                     s8 (logand (- s8 (* v 13)) #xffffffffffffffff)
                     s9 (logand (+ s9 (logxor v 15)) #xffffffffffffffff)
                     s10 (logand (+ s10 v 17) #xffffffffffffffff)
                     s11 (logand (logxor s11 (+ v 19)) #xffffffffffffffff)
                     s12 (logand (+ s12 (* v 21)) #xffffffffffffffff))))
           (values (+ r1 r2 (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12)
                                    #xffffffff))
                   m1 m2))))
    (assert (null notes))
    (assert (disassembly-contains-p fn "R12"))
    (let ((buf (make-array 64 :element-type '(unsigned-byte 64) :initial-element 3)))
      (assert (equal (multiple-value-list (funcall fn buf 0 nil nil)) '(131 nil nil)))
      (assert (equal (multiple-value-list (funcall fn buf 0 7 9)) '(151 nil 7)))
      (let* ((pinned (compile nil '(lambda (buf n)
                                    (declare (type (simple-array (unsigned-byte 64) (*)) buf)
                                             (type fixnum n))
                                    (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
                                          (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13))
                                      (dotimes (i n)
                                        (let ((v (aref buf (logand i 63))))
                                          (setf s0 (logand (+ s0 v) #xffffffffffffffff)
                                                s1 (logand (logxor s1 (+ v 1)) #xffffffffffffffff)
                                                s2 (logand (+ s2 (* v 3)) #xffffffffffffffff)
                                                s3 (logand (- s3 v) #xffffffffffffffff)
                                                s4 (logand (logxor s4 (* v 5)) #xffffffffffffffff)
                                                s5 (logand (+ s5 v 7) #xffffffffffffffff)
                                                s6 (logand (logxor s6 (+ v 9)) #xffffffffffffffff)
                                                s7 (logand (+ s7 (* v 11)) #xffffffffffffffff)
                                                s8 (logand (- s8 (* v 13)) #xffffffffffffffff)
                                                s9 (logand (+ s9 (logxor v 15)) #xffffffffffffffff)
                                                s10 (logand (+ s10 v 17) #xffffffffffffffff)
                                                s11 (logand (logxor s11 (+ v 19)) #xffffffffffffffff)
                                                s12 (logand (+ s12 (* v 21)) #xffffffffffffffff))))
                                      (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12)
                                              #xffffffff)))))
             (sum (funcall pinned buf 8)))
        (assert (equal (multiple-value-list (funcall fn buf 8 nil 5))
                       (list (+ 10 40 sum) 5 nil)))
        (assert (equal (multiple-value-list (funcall fn buf 8 9 nil))
                       (list (+ 20 30 sum) nil nil))))))
  ;; IF-EQ when X is spilled to control-stack must still compile and compare accurately.
  (let* ((vars '(a b c d e f g h i j k l m n o p q r s u v w))
         (fn (compile nil
                      `(lambda (x ,@vars)
                         (declare (sb-ext:unpin-nil) (fixnum ,@vars)
                                  (optimize (speed 1) (safety 1) #+sb-safepoint (sb-c:insert-safepoints 0)))
                         (let ((is-nil (if (eq x nil) 1 0)))
                           (+ is-nil ,@vars))))))
    (assert (= (apply fn nil (loop for i below 22 collect i))
               (1+ (reduce #'+ (loop for i below 22 collect i)))))
    (assert (= (apply fn 42 (loop for i below 22 collect i))
               (reduce #'+ (loop for i below 22 collect i)))))
  ;; %SET-SAP-REF-LISPOBJ storing NIL under register pressure.
  (multiple-value-bind (sap-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (sap off n)
         (declare (type sb-sys:system-area-pointer sap)
                  (type fixnum off n)
                  (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0))
                  (sb-ext:unpin-nil))
         (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
               (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13))
           (declare (type (unsigned-byte 64)
                          s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12))
           (dotimes (i n)
             (let ((v (logand i 15)))
               (setf s0 (logand (+ s0 v) #xffffffffffffffff)
                     s1 (logand (+ s1 v) #xffffffffffffffff)
                     s2 (logand (+ s2 v) #xffffffffffffffff)
                     s3 (logand (+ s3 v) #xffffffffffffffff)
                     s4 (logand (+ s4 v) #xffffffffffffffff)
                     s5 (logand (+ s5 v) #xffffffffffffffff)
                     s6 (logand (+ s6 v) #xffffffffffffffff)
                     s7 (logand (+ s7 v) #xffffffffffffffff)
                     s8 (logand (+ s8 v) #xffffffffffffffff)
                     s9 (logand (+ s9 v) #xffffffffffffffff)
                     s10 (logand (+ s10 v) #xffffffffffffffff)
                     s11 (logand (+ s11 v) #xffffffffffffffff)
                     s12 (logand (+ s12 v) #xffffffffffffffff))))
           (setf (sb-sys:sap-ref-lispobj sap 0) nil
                 (sb-sys:sap-ref-lispobj sap off) nil)
           (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12) #xffffffff))))
    (assert (null notes))
    (assert (disassembly-contains-p sap-fn "R12"))
    (let ((mem (sb-alien:make-alien sb-alien:unsigned-long 4)))
      (unwind-protect
           (let ((sap (sb-alien:alien-sap mem)))
             (setf (sb-sys:sap-ref-64 sap 0) 123456
                   (sb-sys:sap-ref-64 sap 8) 789012)
             (funcall sap-fn sap 8 10)
             (assert (null (sb-sys:sap-ref-lispobj sap 0)))
             (assert (null (sb-sys:sap-ref-lispobj sap 8))))
        (sb-alien:free-alien mem))))
  ;; Zero-value and 2-value CRETURN default unused register arg slots to NIL.
  (multiple-value-bind (mv0 notes0)
      (compile-capturing-unpin-notes
       '(lambda ()
         (declare (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)) (sb-ext:unpin-nil))
         (values)))
    (assert (null notes0))
    (assert (null (multiple-value-list (funcall mv0)))))
  (multiple-value-bind (mv2 notes2)
      (compile-capturing-unpin-notes
       '(lambda (buf n)
         (declare (type (simple-array (unsigned-byte 64) (*)) buf)
                  (type fixnum n)
                  (optimize (speed 3) (safety 0) (debug 0) #+sb-safepoint (sb-c:insert-safepoints 0))
                  (sb-ext:unpin-nil))
         (let ((s0 1) (s1 2) (s2 3) (s3 4) (s4 5) (s5 6) (s6 7)
               (s7 8) (s8 9) (s9 10) (s10 11) (s11 12) (s12 13))
           (declare (type (unsigned-byte 64)
                          s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12))
           (dotimes (i n)
             (let ((v (aref buf (logand i 63))))
               (setf s0 (logand (+ s0 v) #xffffffffffffffff)
                     s1 (logand (+ s1 v) #xffffffffffffffff)
                     s2 (logand (+ s2 v) #xffffffffffffffff)
                     s3 (logand (+ s3 v) #xffffffffffffffff)
                     s4 (logand (+ s4 v) #xffffffffffffffff)
                     s5 (logand (+ s5 v) #xffffffffffffffff)
                     s6 (logand (+ s6 v) #xffffffffffffffff)
                     s7 (logand (+ s7 v) #xffffffffffffffff)
                     s8 (logand (+ s8 v) #xffffffffffffffff)
                     s9 (logand (+ s9 v) #xffffffffffffffff)
                     s10 (logand (+ s10 v) #xffffffffffffffff)
                     s11 (logand (+ s11 v) #xffffffffffffffff)
                     s12 (logand (+ s12 v) #xffffffffffffffff))))
           (values (logand (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12) #xffffffff)
                   (logand s0 #xffffffff)))))
    (assert (null notes2))
    (assert (disassembly-contains-p mv2 "R12"))
    (let ((buf (make-array 64 :element-type '(unsigned-byte 64) :initial-element 2)))
      (assert (equal (multiple-value-list (funcall mv2 buf 3))
                     (list (+ 91 (* 13 6)) 7)))))
  ;; FUN-CODE-HEADER uses CMOV :Z (NIL-OPERAND) and compiles unpinned.
  (multiple-value-bind (fch-fn notes)
      (compile-capturing-unpin-notes
       '(lambda (f)
         (declare (function f) (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)) (sb-ext:unpin-nil))
         (sb-kernel:fun-code-header f)))
    (assert (null notes))
    (assert (eq (funcall fch-fn #'car) (sb-kernel:fun-code-header #'car)))
    (assert (eq (funcall fch-fn fch-fn) (sb-kernel:fun-code-header fch-fn))))
  (verify-nil-intact))

;;; The VOPs that were converted to use the constant-pool NIL must really be
;;; the ones that run: the names of the VOPs that asked for NIL-OPERAND while
;;; unpinned.
(defun vops-using-nil-operand (lambda-form)
  (let ((vops nil))
    (sb-int:encapsulate
     'sb-vm::nil-operand 'record
     (lambda (f &rest args)
       (when sb-c::*unpin-nil-trap-active*
         (pushnew (sb-c::vop-info-name (sb-c::vop-info sb-assem::*current-vop*)) vops))
       (apply f args)))
    (unwind-protect
         (handler-bind ((warning #'muffle-warning)
                        (sb-ext:compiler-note #'muffle-warning))
           (compile nil lambda-form))
      (sb-int:unencapsulate 'sb-vm::nil-operand 'record))
    vops))

(with-test (:name :unpin-nil-nil-operand-reached)
  (assert (member 'sb-vm::return
                  (vops-using-nil-operand
                   '(lambda (x) (declare (sb-ext:unpin-nil) (ignore x)
                                        (optimize (speed 3) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (values)))))
  (assert (member 'sb-kernel:fun-code-header
                  (vops-using-nil-operand
                   '(lambda (f) (declare (sb-ext:unpin-nil) (function f)
                                        (optimize (speed 3) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (sb-kernel:fun-code-header f)))))
  (assert (member 'sb-vm::length/list
                  (vops-using-nil-operand
                   '(lambda (l) (declare (sb-ext:unpin-nil) (list l)
                                        (optimize (speed 3) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (length l))))))

;;; MOD and REM leave an ENCLOSE node behind that makes no closure; it must not
;;; keep the component from being unpinned. A real closure still does.
(with-test (:name :unpin-nil-mod-rem-stay-unpinned)
  (flet ((notes-of (form)
           (nth-value 1 (compile-capturing-unpin-notes form))))
    (dolist (op '(mod rem))
      (let ((form `(lambda (a)
                     (declare (sb-ext:unpin-nil) (type (unsigned-byte 32) a)
                              (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                     (,op a 65521))))
        (assert (null (notes-of form)))
        (assert (= (funcall (compile nil form) 1000003) (funcall op 1000003 65521)))))
    (assert (= 1 (length (notes-of
                          '(lambda (n)
                            (declare (sb-ext:unpin-nil) (fixnum n)
                                     (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                            (lambda (x) (+ x n)))))))))

;;; A full call sets R12 to NIL for the callee, and the values that live across
;;; it come back: many accumulators stay live over calls to a function that
;;; looks at NIL, and over one that signals an error that is handled outside.
(defun full-call-lambda (unpin)
  (let ((vars '(a b c d e f g h i j k l m n)))
    `(lambda (x callee-1 callee-2)
       (declare ,@(when unpin '((sb-ext:unpin-nil)))
                (type (unsigned-byte 32) x) (type function callee-1 callee-2)
                (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
       (let ,(loop for v in vars for k from 1 collect `(,v (+ x ,k)))
         (declare (type (unsigned-byte 32) ,@vars))
         (dotimes (iter 5)
           (setf ,@(loop for (v w) on (append vars (list (first vars))) by #'cdr
                         while w
                         append `(,v (logand (+ ,v ,w (the (unsigned-byte 16)
                                                           (funcall callee-1 iter)))
                                             #xffffff)))))
         (when (funcall callee-2 x) (setf a 7))
         (+ ,@vars)))))

(with-test (:name :unpin-nil-full-calls)
  (multiple-value-bind (unpinned notes)
      (compile-capturing-unpin-notes (full-call-lambda t))
    (let ((pinned (compile nil (full-call-lambda nil)))
          (f (lambda (i) (if (eq (cdr (list nil)) nil) i 1000))) ; looks at NIL
          (g (lambda (x) (eq x nil))))
      (assert (null notes))
      (assert (disassembly-contains-p unpinned "R12"))
      (dolist (x '(0 1 77 100000))
        (assert (= (funcall unpinned x f g) (funcall pinned x f g)))
        (verify-nil-intact))))
  ;; An error signalled by a called function, handled by the caller's caller.
  (let ((fn (compile nil '(lambda (x f)
                           (declare (sb-ext:unpin-nil) (type fixnum x) (type function f)
                                    (optimize (speed 3) (safety 0) #+sb-safepoint (sb-c:insert-safepoints 0)))
                           (let ((a (+ x 1)) (b (+ x 2)) (c (+ x 3)) (d (+ x 4)))
                             (declare (type fixnum a b c d))
                             (when (> x 5) (funcall f x))
                             (+ a b c d))))))
    (assert (= (funcall fn 1 #'identity) 14))
    (assert (eq :caught (handler-case (funcall fn 10 (lambda (x) (error "x ~a" x)))
                          (error () :caught))))
    (verify-nil-intact)))

;;; On #+sb-safepoint targets (always on :win32), a safepoint at the
;;; function's entry reads NIL directly, so the component falls back
;;; unless the function also turns safepoint insertion off.
(with-test (:name :unpin-nil-safepoint)
  #-sb-safepoint
  (let ((notes (nth-value 1 (compile-capturing-unpin-notes
                             '(lambda (x) (declare (sb-ext:unpin-nil) (fixnum x))
                               (+ x 1))))))
    (assert (null notes)))
  #+sb-safepoint
  (progn
    (let ((notes (nth-value 1 (compile-capturing-unpin-notes
                               '(lambda (x) (declare (sb-ext:unpin-nil) (fixnum x)
                                            (optimize (speed 3)))
                                 (+ x 1))))))
      (assert (= 1 (length notes)))
      (assert (search "(:SAFEPOINT)" (first notes))))
    (multiple-value-bind (fn notes)
        (compile-capturing-unpin-notes
         '(lambda (x)
           (declare (sb-ext:unpin-nil) (fixnum x)
                    (optimize (sb-c:insert-safepoints 0)))
           (+ x 1)))
      (assert (null notes))
      (assert (= (funcall fn 1) 2))
      (verify-nil-intact))))
