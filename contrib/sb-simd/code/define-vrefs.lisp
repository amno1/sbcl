                  (multiple-value-bind (vector index)
                      (sb-kernel:%data-vector-and-index array index)
                    (declare (type (simple-array ,element-type (*)) vector))
                    (,vop-e-load-m (,mask-cast mask) (,type-cast default) vector index 0)))

                ;; 6. Memory expand load merging (SAP)
                (define-inline ,e-sap-load-m-name (mask default sap index)
                  (declare (type sb-alien:system-area-pointer sap)
                           (type index index))
                  (,vop-e-sap-load-m (,mask-cast mask) (,type-cast default) sap index 0)))))))
