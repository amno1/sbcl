(macrolet
    ((def-broadcast-refs (type element-type mask-type)
       (let* ((pkg (find-package "SB-SIMD-AVX512F"))
              (bc-name           (mksym pkg type "-BROADCAST-AREF"))
              (bc-z-name         (mksym pkg type "-BROADCAST-AREF-MASKED-Z"))
              (bc-m-name         (mksym pkg type "-BROADCAST-AREF-MASKED"))
              (sap-bc-name       (mksym pkg type "-BROADCAST-SAP-REF"))
              (sap-bc-z-name     (mksym pkg type "-BROADCAST-SAP-REF-MASKED-Z"))
              (sap-bc-m-name     (mksym pkg type "-BROADCAST-SAP-REF-MASKED"))

              (vop-bc            (mksym pkg "%" type "-BROADCAST-AREF"))
              (vop-bc-z          (mksym pkg "%" type "-BROADCAST-AREF-MASKED-Z"))
              (vop-bc-m          (mksym pkg "%" type "-BROADCAST-AREF-MASKED"))
              (vop-sap-bc        (mksym pkg "%" type "-BROADCAST-SAP-REF"))
              (vop-sap-bc-z      (mksym pkg "%" type "-BROADCAST-SAP-REF-MASKED-Z"))
              (vop-sap-bc-m      (mksym pkg "%" type "-BROADCAST-SAP-REF-MASKED"))

              (type-cast         (mksym pkg type))
              (mask-cast         (mksym pkg mask-type))
              (broadcast-sym     (mksym pkg type "-BROADCAST")))
         (if (not (instruction-set-available-p (find-instruction-set :avx512f)))
             `(progn
                (defun ,bc-name (array &rest indices)
                  (declare (ignore array indices))
                  (error "AVX512F instruction ~S not supported." ',bc-name))
                (defun ,bc-z-name (mask array &rest indices)
                  (declare (ignore mask array indices))
                  (error "AVX512F instruction ~S not supported." ',bc-z-name))
                (defun ,bc-m-name (mask default array &rest indices)
                  (declare (ignore mask default array indices))
                  (error "AVX512F instruction ~S not supported." ',bc-m-name))
                (defun ,sap-bc-name (sap index)
                  (declare (ignore sap index))
                  (error "AVX512F instruction ~S not supported." ',sap-bc-name))
                (defun ,sap-bc-z-name (mask sap index)
                  (declare (ignore mask sap index))
                  (error "AVX512F instruction ~S not supported." ',sap-bc-z-name))
                (defun ,sap-bc-m-name (mask default sap index)
                  (declare (ignore mask default sap index))
                  (error "AVX512F instruction ~S not supported." ',sap-bc-m-name)))
             `(progn
                ;; 1. Unmasked broadcast from array
                (defun ,bc-name (array &rest indices)
                  (declare (type (array ,element-type) array))
                  (let ((idx (if (= (length indices) 1)
                                 (first indices)
                                 (apply #'array-row-major-index array indices))))
                    (declare (type index idx))
                    (sb-kernel:check-bound array (array-total-size array) idx)
                    (multiple-value-bind (vector index)
                        (sb-kernel:%data-vector-and-index array idx)
                      (declare (type (simple-array ,element-type (*)) vector))
                      (,vop-bc vector index 0))))

                (define-compiler-macro ,bc-name (array &rest indices)
                  (if (= (length indices) 1)
                      (let ((arr (gensym "ARR"))
                            (idx (gensym "IDX"))
                            (vec (gensym "VEC"))
                            (vidx (gensym "VIDX")))
                        `(let ((,arr ,array)
                               (,idx ,(first indices)))
                           (declare (type (array ,',element-type) ,arr)
                                    (type index ,idx))
                           (sb-kernel:check-bound ,arr (array-total-size ,arr) ,idx)
                           (multiple-value-bind (,vec ,vidx)
                               (sb-kernel:%data-vector-and-index ,arr ,idx)
                             (declare (type (simple-array ,',element-type (*)) ,vec))
                             (,',vop-bc ,vec ,vidx 0))))
                      `(,',bc-name ,array (apply #'array-row-major-index ,array ,@indices))))

                ;; 2. Unmasked broadcast from SAP
                (define-inline ,sap-bc-name (sap index)
                  (declare (type sb-alien:system-area-pointer sap)
                           (type index index))
                  (,vop-sap-bc sap index 0))

                ;; 3. Masked-Z broadcast from array
                (defun ,bc-z-name (mask array &rest indices)
                  (declare (type (array ,element-type) array))
                  (let ((idx (if (= (length indices) 1)
                                 (first indices)
                                 (apply #'array-row-major-index array indices))))
                    (declare (type index idx))
                    (let ((int-mask (if (integerp mask) mask (mask-value mask))))
                      (when (plusp int-mask)
                        (sb-kernel:check-bound array (array-total-size array) idx)))
                    (multiple-value-bind (vector index)
                        (sb-kernel:%data-vector-and-index array idx)
                      (declare (type (simple-array ,element-type (*)) vector))
                      (,vop-bc-z (,mask-cast mask) vector index 0))))

                (define-compiler-macro ,bc-z-name (mask array &rest indices)
                  (if (= (length indices) 1)
                      (let ((m (gensym "MASK"))
                            (arr (gensym "ARR"))
                            (idx (gensym "IDX"))
                            (vec (gensym "VEC"))
                            (vidx (gensym "VIDX"))
                            (im (gensym "INT-MASK")))
                        `(let ((,m ,mask)
                               (,arr ,array)
                               (,idx ,(first indices)))
                           (declare (type (array ,',element-type) ,arr)
                                    (type index ,idx))
                           (let ((,im (if (integerp ,m) ,m (mask-value ,m))))
                             (when (plusp ,im)
                               (sb-kernel:check-bound ,arr (array-total-size ,arr) ,idx)))
                           (multiple-value-bind (,vec ,vidx)
                               (sb-kernel:%data-vector-and-index ,arr ,idx)
                             (declare (type (simple-array ,',element-type (*)) ,vec))
                             (,',vop-bc-z (,',mask-cast ,m) ,vec ,vidx 0))))
                      `(,',bc-z-name ,mask ,array (apply #'array-row-major-index ,array ,@indices))))

                ;; 4. Masked-Z broadcast from SAP
                (define-inline ,sap-bc-z-name (mask sap index)
                  (declare (type sb-alien:system-area-pointer sap)
                           (type index index))
                  (,vop-sap-bc-z (,mask-cast mask) sap index 0))

                ;; 5. Masked Merging broadcast from array
                (defun ,bc-m-name (mask default array &rest indices)
                  (declare (type (array ,element-type) array))
                  (let ((idx (if (= (length indices) 1)
                                 (first indices)
                                 (apply #'array-row-major-index array indices))))
                    (declare (type index idx))
                    (let ((int-mask (if (integerp mask) mask (mask-value mask))))
                      (when (plusp int-mask)
                        (sb-kernel:check-bound array (array-total-size array) idx)))
                    (multiple-value-bind (vector index)
                        (sb-kernel:%data-vector-and-index array idx)
                      (declare (type (simple-array ,element-type (*)) vector))
                      (,vop-bc-m (,mask-cast mask) (,type-cast default) vector index 0))))

                (define-compiler-macro ,bc-m-name (mask default array &rest indices)
                  (if (= (length indices) 1)
                      (let ((m (gensym "MASK"))
                            (d (gensym "DEF"))
                            (arr (gensym "ARR"))
                            (idx (gensym "IDX"))
                            (vec (gensym "VEC"))
                            (vidx (gensym "VIDX"))
                            (im (gensym "INT-MASK")))
                        `(let ((,m ,mask)
                               (,d ,default)
                               (,arr ,array)
                               (,idx ,(first indices)))
                           (declare (type (array ,',element-type) ,arr)
                                    (type index ,idx))
                           (let ((,im (if (integerp ,m) ,m (mask-value ,m))))
                             (when (plusp ,im)
                               (sb-kernel:check-bound ,arr (array-total-size ,arr) ,idx)))
                           (multiple-value-bind (,vec ,vidx)
                               (sb-kernel:%data-vector-and-index ,arr ,idx)
                             (declare (type (simple-array ,',element-type (*)) ,vec))
                             (,',vop-bc-m (,',mask-cast ,m) (,',type-cast ,d) ,vec ,vidx 0))))
                      `(,',bc-m-name ,mask ,default ,array (apply #'array-row-major-index ,array ,@indices))))

                ;; 6. Masked Merging broadcast from SAP
                (define-inline ,sap-bc-m-name (mask default sap index)
                  (declare (type sb-alien:system-area-pointer sap)
                           (type index index))
                  (,vop-sap-bc-m (,mask-cast mask) (,type-cast default) sap index 0))

                ;; Compiler macro for (<type>-broadcast (aref ...))
                (define-compiler-macro ,broadcast-sym (&whole form arg)
                  (cond
                    ((and (consp arg) (eq (first arg) 'aref))
                     `(,',bc-name ,@(rest arg)))
                    ((and (consp arg) (eq (first arg) 'row-major-aref))
                     `(,',bc-name ,@(rest arg)))
                    (t form))))))))
  (def-broadcast-refs f32.16 single-float          m32.16)
  (def-broadcast-refs f64.8  double-float          m64.8)
  (def-broadcast-refs u32.16 (unsigned-byte 32)    m32.16)
