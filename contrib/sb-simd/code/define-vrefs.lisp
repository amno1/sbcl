                  (,c-store-name mask value array index))

                ;; 2. Memory compress store (SAP)
                (define-inline ,c-sap-store-name (mask value sap index)
                  (declare (type sb-alien:system-area-pointer sap)
                           (type index index))
                  (,vop-c-sap-store (,mask-cast mask) (,type-cast value) sap index 0))

                (define-inline (setf ,c-sap-store-name) (value mask sap index)
                  (declare (type sb-alien:system-area-pointer sap)
                           (type index index))
