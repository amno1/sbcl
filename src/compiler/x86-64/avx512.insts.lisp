  '(:NAME :TAB REG ", " REG/MEM))
 (:PRINTER VEX2-KREG-KREG/MEM ((PP 1) (OP 144) (W 0) (L 0)))
 (:EMITTER
  (PROGN
   (COND
    ((EA-P DST)
     (IF (NEEDS-EVEX-P NIL NIL NIL DST SRC)
         (EMIT-AVX512-INST SEGMENT DST SRC 102 145 :VVVV NIL :W 0 :MAP 1
                           :EVEX-B 0 :DISP-N (FULL-VECTOR-DISP-N SRC))
         (PROGN
          (EMIT-VEX SEGMENT NIL DST SRC 102 15 NIL 0)
          (EMIT-BYTE SEGMENT 145)
          (EMIT-EA SEGMENT DST SRC))))
    ((EA-P SRC)
     (IF (NEEDS-EVEX-P NIL NIL NIL DST SRC)
         (EMIT-AVX512-INST SEGMENT SRC DST 102 144 :VVVV NIL :W 0 :MAP 1
                           :EVEX-B 0 :DISP-N (FULL-VECTOR-DISP-N DST))
         (PROGN
          (EMIT-VEX SEGMENT NIL SRC DST 102 15 NIL 0)
          (EMIT-BYTE SEGMENT 144)
          (EMIT-EA SEGMENT SRC DST))))
    (T
     (IF (NEEDS-EVEX-P NIL NIL NIL DST SRC)
         (EMIT-AVX512-INST SEGMENT SRC DST 102 147 :VVVV NIL :W 0 :MAP 1
                           :EVEX-B 0 :DISP-N (FULL-VECTOR-DISP-N DST))
         (PROGN
