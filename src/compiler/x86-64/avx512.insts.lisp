;;; Generated instruction definitions
(in-package "SB-X86-64-ASM")
(eval-when (:compile-toplevel :load-toplevel :execute)
  (setf (symbol-value (find-symbol "*BACKEND-INSTRUCTION-SET-PACKAGE*" "SB-ASSEM"))
        (find-package "SB-X86-64-ASM")))

;;; ------------------------------------------------------------------
;;; Runtime support for the generated EMITTERs below.

;; True if REG is a real (non-EA) TN with an extended index (16-31) --
;; XMM16-31/YMM16-31/ZMM16-31 are only addressable via EVEX, regardless
;; of width, since VEX's vvvv/ModRM.reg/rm fields are 4 bits wide.
(defun avx512-register-p (reg)
  (and reg
       (not (ea-p reg))
       (typep reg 'sb-c:tn)
       (>= (sb-c:tn-offset reg) 16)))

;; True if REG is a real (non-EA) ZMM-width register. VEX tops out at
;; YMM/256-bit, so any ZMM operand forces EVEX regardless of its index.
(defun avx512-width-register-p (reg)
  (and reg (not (ea-p reg)) (zmm-register-p reg)))

;; Auto-promotion check for a BASE (unsuffixed) instruction: true if K,
;; Z, or BCAST was supplied, or if any of REGS is a register VEX cannot
;; address. -MASKED/-BCAST/-MASKED-BCAST instructions never call this
;;, they emit EVEX unconditionally, since VEX cannot express masking
;; or broadcast at all, only the plain name needs to choose.
(defun needs-evex-p (k z bcast &rest regs)
  (or k z bcast
      (some (lambda (r) (or (avx512-register-p r) (avx512-width-register-p r)))
            (remove nil regs))))

;; Compressed-displacement scale factor (Intel's tuple-type "N") for a
;; full-vector (non-broadcast) memory operand, based on REG's actual
;; width: 64 for a ZMM operand, 32 for YMM, 16 for XMM or anything
;; narrower. Broadcast forms scale by element size instead (4 or 8
;; bytes, regardless of vector width), see the compile-time constant
;; spliced in by DISP-N-EXPR in the generator, not this function.
(defun full-vector-disp-n (reg)
  (cond ((and reg (not (ea-p reg)) (zmm-register-p reg)) 64)
        ((and reg (not (ea-p reg)) (ymm-register-p reg)) 32)
        (t 16)))

;; Normalize a MASK argument (either a raw k-register number, as used
;; internally, or a real k-register TN, as a caller would naturally
;; pass) to the raw number EMIT-AVX512-INST's :AAA wants.
(defun mask-arg-number (mask)
  (cond ((integerp mask) mask)
        ((k-register-p mask) (reg-id-num (reg-id mask)))
        (t (error "Invalid mask ~S" mask))))

