(DEFINE-INSTRUCTION KMOVB (SEGMENT DST SRC)
 (:PRINTER EVEX-YMM-YMM/MEM ((PP 1) (MM 1) (EVEX-U 0) (OP 147) (W 0) (LL 0)))
 (:PRINTER EVEX-YMM-YMM/MEM ((PP 1) (MM 1) (EVEX-U 0) (OP 145) (W 0) (LL 0))
